# ADRA Applied — configuration template.
# Copy to a local, git-ignored `.env`. Never commit real values.
# Endpoints and the production reference branch are configuration, never guessed.

# --- behavior ---
ADRA_ALLOW_EXTERNAL=0            # 1 enables gated tools (still confirm outward actions)
ADRA_REPO_PATH=                 # local path of the repo under analysis
ADRA_RUNS_DIR=runs              # where provenance run records are written (git-ignored)

# --- production reference branch (per team; never guessed) ---
ADRA_PROD_REF_BRANCH=main       # or develop, per the team's definition

# --- GitHub (or rely on `gh auth login`) ---
GH_TOKEN=

# --- Azure DevOps ---
AZURE_DEVOPS_ORG=               # https://dev.azure.com/<org>
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_EXT_PAT=           # PAT for `az devops` (or use `az login`)

# --- Databricks (profiles live in ~/.databrickscfg; ids are per environment) ---
DATABRICKS_DEV_PROFILE=dev
DATABRICKS_PROD_PROFILE=prod
DATABRICKS_WAREHOUSE_ID_DEV=
DATABRICKS_WAREHOUSE_ID_PROD=

# --- Azure ---
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# --- optional: point the rubric at a different client governance suite ---
ADRA_CLIENT_DIR=

# The model runtime is provided by the agent harness, so no LLM provider keys are
# needed for the skill itself.
